rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MODELO: troque os e-mails pelos reais SÓ no console do Firebase, nunca aqui (repositório público).
    // Cada e-mail aponta para o perfil do piloto no app.
    function pilotos() {
      return {
        'SEU_EMAIL@gmail.com': 'jaco',
        'EMAIL_DO_KAIQUE@gmail.com': 'kaique'
      };
    }
    function membro() {
      return request.auth != null && request.auth.token.email in pilotos();
    }
    function eu() {
      return pilotos()[request.auth.token.email];
    }
    function admin() {
      return membro() && eu() == 'jaco';
    }

    // Viagem (roteiro, datas, gasolina, textos do Sobre): os dois editam juntos.
    // Só o admin muda as férias, o papel de admin e o texto/autor de “Sobre o app”.
    function pessoalIntacto() {
      let antes = resource.data;
      let depois = request.resource.data;
      return depois.get('feriasFim', null) == antes.get('feriasFim', null)
        && depois.get('admin', null) == antes.get('admin', null)
        && depois.get('about', {}).get('appinfo', null) == antes.get('about', {}).get('appinfo', null)
        && depois.get('about', {}).get('author', null) == antes.get('about', {}).get('author', null);
    }
    match /trips/{tripId} {
      allow read: if membro();
      allow create: if admin();
      allow update: if admin() || (membro() && pessoalIntacto());
      allow delete: if admin();
    }
    // Perfil do piloto e checklist: cada um altera o seu
    match /trips/{tripId}/riders/{rid} {
      allow read: if membro();
      allow write: if admin() || rid == eu();
    }
    match /trips/{tripId}/checklist/{rid} {
      allow read: if membro();
      allow write: if rid == eu();
    }
    // Gastos da viagem: cada um cria, altera e apaga os que pagou
    match /trips/{tripId}/expenses/{id} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.rider == eu();
      allow update: if membro() && resource.data.rider == eu() && request.resource.data.rider == eu();
      allow delete: if membro() && resource.data.rider == eu();
    }
    // Mapa, hospedagem e pendências: os dois editam juntos
    match /trips/{tripId}/points/{id} {
      allow read, write: if membro();
    }
    match /trips/{tripId}/lodging/{id} {
      allow read, write: if membro();
    }
    match /trips/{tripId}/meta/{id} {
      allow read, write: if membro();
    }
    // Meus gastos: cada conta lê e escreve só a própria área
    match /trips/{tripId}/private/{uid}/{document=**} {
      allow read, write: if membro() && request.auth.uid == uid;
    }
  }
}
